# ============================================================
# 销售线索智能分析与分发助手 —— 环境配置示例
# 使用方法: 复制本文件为 config/.env 并填入真实值。
# 所有键均可被同名环境变量覆盖(pydantic-settings 内建支持)。
# ============================================================

# ---- 统一 LLM 网关 provider 选择 ----
# kimi:   Anthropic Messages 接口(api.kimi.com/coding 等), 当前默认;
# openai: OpenAI 兼容 Chat Completions(OpenAI/DeepSeek/通义/vLLM 等), 预留。
LLM_PROVIDER="kimi"

# ---- 大模型(OpenAI 兼容接口, 支持 DeepSeek/通义等; LLM_PROVIDER=openai 时生效) ----
# 接口 Base URL。DeepSeek 官方: https://api.deepseek.com/v1 ;
# 通义千问(阿里云百炼): https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_BASE="https://api.deepseek.com/v1"

# API Key。在 DeepSeek 开放平台 https://platform.deepseek.com/ 创建;
# 留空 + mock_mode=True 时画像分析走规则引擎, 不调用大模型。
LLM_API_KEY=""

# 模型名称。DeepSeek 可用 deepseek-chat / deepseek-reasoner;
# 通义可用 qwen-plus / qwen-max 等。
LLM_MODEL="deepseek-chat"

# 大模型调用超时(秒)。
LLM_TIMEOUT=60.0

# ---- 钉钉自定义机器人 ----
# 机器人的 Webhook 地址。在钉钉群 -> 群设置 -> 智能群助手 -> 添加机器人
# (自定义/自定义机器人) 中创建, 复制 "Webhook" 地址填入。
DINGTALK_WEBHOOK_URL=""

# 加签密钥(可选)。若创建机器人时勾选了"加签"安全设置,
# 将生成的 SEC 密钥填到这里; 未勾选则留空。
DINGTALK_SECRET=""

# ---- 飞书自定义机器人 ----
# 机器人的 Webhook 地址。在飞书群 -> 设置 -> 群机器人 -> 添加机器人
# (自定义机器人) 中创建, 复制 "Webhook" 地址填入。
# 无需企业组织, 个人群也可创建机器人。
FEISHU_WEBHOOK_URL=""

# 加签密钥(可选)。若创建机器人时勾选了"签名校验"安全设置,
# 将生成的密钥填到这里; 未勾选(仅"自定义关键词")则留空。
FEISHU_SECRET=""

# ---- 飞书企业自建应用(发送个人工作通知单聊卡片, 可选) ----
# 未配置时个人工作通知自动跳过; 凭证敏感, 请勿提交到仓库。
FEISHU_APP_ID=""

FEISHU_APP_SECRET=""

# 易销网页应用公网地址(销售从飞书卡片/网页应用进入易销移动端的入口)。
FEISHU_WEBAPP_URL=""

# 销售人员 ID -> 飞书绑定手机号映射 (用于一对一定向推送工作通知)。
# 格式: S001:13800000001,S002:13800000002
SALES_MOBILE_MAP=""

# 通知通道统一入口默认通道: feishu | dingtalk。
# 实际发送时"谁配了 webhook 用谁": 默认通道未配置而另一通道已配置则自动切换。
NOTIFIER_CHANNEL="feishu"

# ---- HTTPS 证书校验 ----
# False 时兼容内网代理/自签名证书环境(默认); 生产环境建议设 True。
VERIFY_SSL=False

# ---- 数据库 ----
# SQLite 数据库文件路径(相对项目根目录)。
DB_PATH="data/sales_agent.db"

# ---- 调度 ----
# 每日定时运行时间(24 小时制 HH:MM)。
DAILY_RUN_TIME="08:30"

# ---- Kimi K2.7 Code(Anthropic Messages 接口) ----
# 用于画像分析 / 销售画像 / 话术生成等语义任务; 留空则全部走规则引擎。
# 配置了 key 即启用(画像分析、销售分析、话术生成都走 Kimi)。
KIMI_API_KEY=""
KIMI_API_BASE="https://api.kimi.com/coding"
KIMI_MODEL="kimi-for-coding"

# ---- 飞书多维表格(Bitable)同步 ----
# base_token 为多维表格访问凭证(敏感, 勿提交); table_id 见飞书表格 URL。
FEISHU_BASE_TOKEN=""
FEISHU_BASE_LEADS_TABLE="tbluJCdsnsMaWYYD"
FEISHU_BASE_SALES_TABLE="tbl9XxtsQVMt30Gr"
FEISHU_BASE_MEMORY_TABLE="tblJeTx2w24LvQdc"

# ---- Mock 模式 ----
# True 时「飞书个人通知」等主动推送静默跳过, 避免测试/演示产生真实外呼;
# 画像分析/销售画像/话术是否走 Kimi 取决于 KIMI_API_KEY 是否配置。
MOCK_MODE=True

# ---- RAG 检索 - Embedding(可选) ----
# Embedding API 端点。例如 OpenAI: https://api.openai.com/v1 ;
# 通义(阿里云百炼): https://dashscope.aliyuncs.com/compatible-mode/v1 。
# 配置了就走 API 向量检索; 留空则用零依赖本地文本相似度兜底。
EMBEDDING_API_BASE=""

# Embedding API Key。在对应平台(如 OpenAI / 阿里云百炼)创建;
# 与 LLM_API_KEY 通常可分别配置。
EMBEDDING_API_KEY=""

# Embedding 模型名称。例如 text-embedding-3-small
# (OpenAI)、text-embedding-v3(通义)等; 留空时同样走本地兜底。
EMBEDDING_MODEL=""

# ---- 电话录音 ASR(adapters/phone_call_adapter) ----
# 语音转写 + 说话人角色判定。provider: mock | aliyun | tencent | xfyun。
# mock 模式读 data/real/phone_call_transcript_demo.json, 不调外部 API。
ASR_PROVIDER="mock"

# 真实 ASR 服务商凭证(接阿里云/腾讯/讯飞时填写, 需带说话人分离能力)。
ASR_API_KEY=""
ASR_API_SECRET=""
ASR_APP_ID=""

# ASR 调用超时(秒)。
ASR_TIMEOUT=120.0

# 角色判定 Tier-3 LLM 兜底是否启用(复用 llm_client)。
PHONE_ROLE_LLM_FALLBACK=True

# 角色判定置信度低于此值打 review 标记(需人工复核)。
PHONE_ROLE_MIN_CONFIDENCE=0.7

# 电话录音 webhook 签名密钥(HMAC-SHA256 校验回调来源)。
# 留空则跳过签名校验(仅内网/演示环境可用, 生产务必配置)。
PHONE_WEBHOOK_SECRET=""

# ---- 企客宝 CRM(主数据源, 可选) ----
# 在 https://console.yunshouzhi.net → API秘钥管理 创建 Client ID / Secret。
# 配置齐全 + QIKEBAO_SYNC_ENABLED=true 时, 流水线客户数据优先来自企客宝。
QIKEBAO_CLIENT_ID=""
QIKEBAO_CLIENT_SECRET=""
QIKEBAO_CORP_ID=""
QIKEBAO_API_BASE=""
QIKEBAO_SYNC_ENABLED=false
QIKEBAO_MOCK_MODE=true
QIKEBAO_SYNC_CHAT=false